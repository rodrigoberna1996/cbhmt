---
import Navbar from "../components/navbar/navbar.astro";
import Footer from "../components/footer.astro";
import "../styles/pages/global.css";

interface Props {
    title: string;
    /** Ruta de la imagen del hero para preload (ej: /img/hero/home.png) */
    preloadHero?: string;
}

const { title, preloadHero } = Astro.props;
---

<!doctype html>
<html lang="es" data-wf-page="64d63a4f8bf48fdf578cbd69">
<head>
    <meta charset="UTF-8"/>
    <meta name="description" content="CBH Mechatooling - Soluciones integrales en diseño mecánico, herramentales, maquinado CNC y automatización industrial para la industria automotriz."/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    {preloadHero && (
      <link rel="preload" as="image" href={preloadHero} fetchpriority="high" />
    )}
    <link rel="stylesheet" href="/asset/library/@splidejs/splide@3.2.2/dist/css/splide-core.min.css"/>

    <script src="/asset/ajax/libs/gsap/3.11.4/gsap.min.js" type="text/javascript"></script>
    <script src="/asset/ajax/libs/gsap/3.11.4/ScrollTrigger.min.js" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/split-type@0.3.4/umd/index.min.js"
            integrity="sha256-7P1m35iIZBh/pYVVKHCohnPhtxGwgA+Q7gUGt69QG80=" crossorigin="anonymous"></script>
    <script src="/asset/ajax/libs/gsap/latest/TweenMax.min.js" type="text/javascript"></script>
    <style>
        .splide__track {
            overflow: visible;
        }
    </style>

    <meta name="generator" content={Astro.generator}/>
    <title>{title}</title>
</head>
<body>
<Navbar/>
<slot/>
<Footer/>

<!-- Modal para ver fotos completas de productos/servicios -->
<div id="image-modal" class="image-modal" aria-hidden="true">
  <div class="image-modal-overlay"></div>
  <button class="image-modal-close" aria-label="Cerrar">&times;</button>
  <button class="image-modal-prev" aria-label="Anterior">&#10094;</button>
  <div class="image-modal-viewer">
    <img class="image-modal-img" src="" alt="" />
  </div>
  <button class="image-modal-next" aria-label="Siguiente">&#10095;</button>
  <div class="image-modal-counter"></div>
</div>
</body>
</html>
<style is:global>
    :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
                45deg,
                rgb(var(--accent)),
                rgb(var(--accent-light)) 30%,
                white 60%
        );
    }

    html {
        font-family: system-ui, sans-serif;
        background: #13151a;
        background-size: 224px;
    }

    code {
        font-family: Menlo,
        Monaco,
        Lucida Console,
        Liberation Mono,
        DejaVu Sans Mono,
        Bitstream Vera Sans Mono,
        Courier New,
        monospace;
    }

    /* Modal para fotos de productos/servicios - diseño acorde al sitio */
    .image-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 10000;
        align-items: center;
        justify-content: center;
        padding: 20px;
        box-sizing: border-box;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .image-modal.is-open {
        display: flex;
        opacity: 1;
    }
    .image-modal-overlay {
        position: absolute;
        inset: 0;
        z-index: 10000;
        background: rgba(21, 21, 21, 0.94);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        cursor: pointer;
        transition: background 0.3s ease;
    }
    .image-modal-overlay:hover {
        background: rgba(21, 21, 21, 0.96);
    }
    /* Zona fija central para la foto */
    .image-modal-viewer {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70vw;
        max-width: 900px;
        height: 80vh;
        max-height: 600px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10001;
    }
    .image-modal-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 10px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(190, 94, 34, 0.15);
    }
    /* Botones fijos: izquierda, derecha, cerrar */
    .image-modal-close {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 10002;
    }
    .image-modal-prev {
        position: fixed;
        top: 50%;
        left: 24px;
        transform: translateY(-50%);
        z-index: 10002;
    }
    .image-modal-next {
        position: fixed;
        top: 50%;
        right: 24px;
        transform: translateY(-50%);
        z-index: 10002;
    }
    .image-modal-close,
    .image-modal-prev,
    .image-modal-next {
        background: rgba(190, 94, 34, 0.9);
        border: none;
        color: #fff;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.25s ease, transform 0.2s ease;
        padding: 0;
    }
    .image-modal-close:hover,
    .image-modal-prev:hover,
    .image-modal-next:hover {
        background-color: #d17a3a;
        transform: scale(1.05);
    }
    .image-modal-prev:hover {
        transform: translateY(-50%) scale(1.05);
    }
    .image-modal-next:hover {
        transform: translateY(-50%) scale(1.05);
    }
    .image-modal-counter {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        color: rgba(255, 255, 255, 0.9);
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.5px;
        z-index: 10002;
    }
    /* Cursor pointer en bloques de imagen clickeables */
    .service_image_block,
    .service_image_block-one,
    .service_image_block-three {
        cursor: pointer;
    }
    @media (max-width: 768px) {
        .image-modal-viewer {
            width: 90vw;
            height: 70vh;
        }
        .image-modal-close,
        .image-modal-prev,
        .image-modal-next {
            width: 44px;
            height: 44px;
            font-size: 20px;
        }
        .image-modal-prev { left: 12px; }
        .image-modal-next { right: 12px; }
        .image-modal-close { top: 16px; right: 16px; }
    }
</style>
