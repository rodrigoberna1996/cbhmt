                },
                speed: 300,
            }).mount();
        }
    }

    slider1();

    // Modal para ver fotos completas de productos/servicios
    (function () {
      var modal = document.getElementById("image-modal");
      if (!modal) return;
      var imgEl = modal.querySelector(".image-modal-img");
      var closeBtn = modal.querySelector(".image-modal-close");
      var overlay = modal.querySelector(".image-modal-overlay");
      var prevBtn = modal.querySelector(".image-modal-prev");
      var nextBtn = modal.querySelector(".image-modal-next");
      var counterEl = modal.querySelector(".image-modal-counter");
      var images = [];
      var currentIndex = 0;

      function openModal(srcs, startIndex) {
        images = srcs || [];
        currentIndex = Math.min(startIndex || 0, Math.max(0, images.length - 1));
        if (images.length) {
          imgEl.src = images[currentIndex];
          imgEl.alt = "Vista ampliada";
          updateCounter();
          prevBtn.style.display = images.length > 1 ? "block" : "none";
          nextBtn.style.display = images.length > 1 ? "block" : "none";
          modal.classList.add("is-open");
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
      }

      function closeModal() {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      function updateCounter() {
        counterEl.textContent = images.length > 1 ? (currentIndex + 1) + " / " + images.length : "";
      }

      function showPrev() {
        if (images.length <= 1) return;
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        imgEl.src = images[currentIndex];
        updateCounter();
      }

      function showNext() {
        if (images.length <= 1) return;
        currentIndex = (currentIndex + 1) % images.length;
        imgEl.src = images[currentIndex];
        updateCounter();
      }

      closeBtn.addEventListener("click", closeModal);
      overlay.addEventListener("click", closeModal);
      prevBtn.addEventListener("click", function (e) { e.stopPropagation(); showPrev(); });
      nextBtn.addEventListener("click", function (e) { e.stopPropagation(); showNext(); });

      document.addEventListener("keydown", function (e) {
        if (!modal.classList.contains("is-open")) return;
        if (e.key === "Escape") closeModal();
        else if (e.key === "ArrowLeft") showPrev();
        else if (e.key === "ArrowRight") showNext();
      });

      document.addEventListener("click", function (e) {
        var block = e.target.closest(".service_image_block, .service_image_block-one, .service_image_block-three, .integration-slideshow, .faro-slideshow, .plc-slideshow, .parts-repairs-slideshow, .welding-slideshow");
        if (!block || e.target.tagName === "BUTTON") return;
        var imgs = block.querySelectorAll("img");
        if (!imgs.length) return;
        var srcs = Array.from(imgs).map(function (img) { return img.src || img.currentSrc; }).filter(Boolean);
        if (!srcs.length) return;
        var active = block.querySelector(".active, .integration-slide.active, .faro-slide.active, .plc-slide.active, .parts-repairs-slide.active, .welding-slide.active");
        var startIndex = 0;
        if (active) {
          var activeSrc = active.src || active.currentSrc;
          var idx = srcs.indexOf(activeSrc);
          if (idx >= 0) startIndex = idx;
        }
        e.preventDefault();
        e.stopPropagation();
        openModal(srcs, startIndex);
      }, true);
    })();
</script>