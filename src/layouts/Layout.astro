</script>

<!-- Steps Animation -->
<script>
    var steps_elements = gsap.utils.toArray("[gsap-anim-step]");

    steps_elements.forEach(function (element) {
        gsap.set(element, {opacity: 0});
    });

    ScrollTrigger.batch("[gsap-anim-step]", {
        onEnter: (batch) => gsap.to(batch, {autoAlpha: 1, stagger: 0.3}),
    });
</script>

<!-- Testimonial animation -->
<script>
    var testimonial_elements = gsap.utils.toArray("[gsap-anim-fade]");
    testimonial_elements.forEach(function (element) {
        var tl = gsap.timeline({
            scrollTrigger: {
                trigger: element,
                start: "top 80%",
                end: "bottom top",
                toggleActions: "play none play none",
            },
        });

        tl.fromTo(
            element,
            {x: "200px", opacity: 0},
            {duration: 1, x: "0px", opacity: 1}
        );
    });
</script>

<!-- Capability animation -->
<script>
    var capability_elements = gsap.utils.toArray("[gsap-anim-capability]");

    capability_elements.forEach(function (element) {
        var scrollfade = element.getAttribute("gsap-anim-capability");

        var tl = gsap.timeline({
            scrollTrigger: {
                trigger: element,
                start: "top bottom",
                end: "bottom top",
                toggleActions: "play none play none",
            },
        });

        if (scrollfade == "title") {
            tl.fromTo(element, {scale: 1.2}, {scale: 1, duration: 1});
        } else if (scrollfade == "text") {
            tl.fromTo(element, {opacity: 0}, {opacity: 1, duration: 1});
        }
    });
</script>


<script src="/asset/library/@splidejs/splide@3.2.2/dist/js/splide.min.js" type="text/javascript"></script>

