<!-- Capability animation -->
<script>
    var capability_elements = gsap.utils.toArray("[gsap-anim-capability]");

    capability_elements.forEach(function (element) {
        var scrollfade = element.getAttribute("gsap-anim-capability");

        var tl = gsap.timeline({
            scrollTrigger: {
                trigger: element,
                start: "top bottom",
                end: "bottom top",
                toggleActions: "play none play none",
            },
        });

        if (scrollfade == "title") {
            tl.fromTo(element, {scale: 1.2}, {scale: 1, duration: 1});
        } else if (scrollfade == "text") {
            tl.fromTo(element, {opacity: 0}, {opacity: 1, duration: 1});
        }
    });
</script>


