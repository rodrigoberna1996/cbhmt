<script>
    gsap.config({
        autoSleep: 60,
        force3D: false,
        nullTargetWarn: false,
        trialWarn: false,
        units: {left: "%", top: "%", rotation: "rad"},
    });
</script>
<script>
    var scaleElement = document.querySelector(".cursor");
    var scaleProperties = {scale: 1.2, duration: 0.3, ease: "power2.out"};

    $("a, .splide__arrow, .scroll_up_block").mouseenter(function () {
        gsap.to(scaleElement, {scale: 2, opacity: 0.4, duration: 0.5});
    });

    $("a, .splide__arrow, .scroll_up_block").mouseleave(function () {
        gsap.to(scaleElement, {scale: 1, opacity: 1, duration: 0.5});
    });

    /* Custom cursor */
    var cursor = $(".drag-circle-block"),
        follower = $(".cursor");
    var posX = 0,
        posY = 0;
    var mouseX = 0,
        mouseY = 0;

    TweenMax.to({}, 0.01, {
        repeat: -1,
        onRepeat: function () {
            posX += (mouseX - posX) / 9;
            posY += (mouseY - posY) / 9;

            TweenMax.set(follower, {css: {left: posX - 12, top: posY - 12}});
            TweenMax.set(cursor, {css: {left: mouseX, top: mouseY}});
        },
    });

    $(document).on("mousemove", function (e) {
        mouseX = e.clientX;
        mouseY = e.clientY;
    });

    $(".mobile_toggle_block").on("click", function () {
        $(".language_dropdown").toggleClass("active");
    });
</script>
<!-- After page load animation -->
<script>
    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", function (event) {
        window.onload = function () {
            window.requestAnimationFrame(function () {
                var hero_heading = document.querySelectorAll(
                    "[gsap-anim-hero-heading]"
                );
                var hero_text = document.querySelectorAll("[gsap-anim-hero-text]");
                var hero_btn = document.querySelectorAll("[gsap-anim-hero-btn]");
                var hero_bg = document.querySelectorAll("[gsap-anim-hero-bg]");
                var hero_nav = document.querySelectorAll("[gsap-anim-nav]");
                var hero_video = document.querySelectorAll("[gsap-anim-hero-video]");

                var title_splitText = new SplitType(hero_heading, {type: "chars"});


                // animate the title
                gsap.from(title_splitText.chars, {
                    duration: 0.5,
                    y: "60%",
                    opacity: 0,
                    rotationX: -90,
                    ease: "power1.inOut",
                    stagger: {amount: 0.7, from: "0"},
                });

                // animate the text
                gsap.fromTo(
                    hero_text,
                    {opacity: 0},
                    {duration: 1, opacity: 1, delay: 0.5}
                );

                // animate the button
                gsap.fromTo(
                    hero_btn,
                    {opacity: 0},
                    {duration: 1, opacity: 1, delay: 1}
                );

                // animate video
                gsap.fromTo(
                    hero_video,
                    {opacity: 0},
                    {duration: 1, opacity: 1, delay: 3.5}
                );

                gsap.set(".prev-cursor-arr", {opacity: 0});
                gsap.set(".next-cursor-arr", {opacity: 0});
            });
        };
    });
</script>

<!-- Title animation -->
<script>
    var elements = gsap.utils.toArray("[gsap-anim-letter]");
    elements.forEach(function (element) {
        // get the scrollfade attribute value
        var scrollfade = element.getAttribute("gsap-anim-letter");
        var splitText = new SplitType(element, {type: "chars"});

        let letter_tl = gsap.timeline({
            scrollTrigger: {
                trigger: element,
                start: "top 80%",
                end: "bottom top",
                toggleActions: "play none none none",
            },
        });

        let letter_t2 = gsap.timeline({
            scrollTrigger: {
                trigger: element,
                start: "top bottom",
                end: "bottom top",
                toggleActions: "play none none none",
            },
        });

        if (scrollfade == "txtstragger") {
            letter_tl.from(splitText.chars, {
                duration: 0.5,
                y: "60%",
                opacity: 0,
                rotationX: -90,
                ease: "power1.inOut",
                stagger: {amount: 0.7, from: "0"},
            });
        } else if (scrollfade == "fade") {
            letter_t2.from(splitText.chars, {
                duration: 0.3,
                opacity: 0,
                ease: "power3.inOut",
                stagger: {amount: 0.7, from: "0"},
            });
        }
    });
</script>

<!-- Clients Logo Animation -->
<script>
    var clientslogo_elements = gsap.utils.toArray("[gsap-anim-clientlogo]");

    clientslogo_elements.forEach(function (element) {
        //gsap.set(element, { opacity: 0 });
        var tl = gsap.timeline({
            scrollTrigger: {
                trigger: element,
                start: "top 80%",
                end: "bottom top",
                toggleActions: "play none play none",
            },
        });

        tl.fromTo(element, {opacity: 0}, {duration: 1, opacity: 1});
    });

    //ScrollTrigger.batch("[gsap-anim-clientlogo]", {
    //onEnter: batch => gsap.to(batch, {autoAlpha: 1, stagger: 0.3}),
    //});
</script>

<!-- Fade up animation -->
<script>
    var fadeup_elements = gsap.utils.toArray("[gsap-anim-fadeup]");

    fadeup_elements.forEach(function (element) {
        var tl = gsap.timeline({
            scrollTrigger: {
                trigger: element,
                start: "top 80%",
                end: "bottom top",
                toggleActions: "play none play none",
