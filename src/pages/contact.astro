---
import Layout from "../layouts/Layout.astro";
import "../../src/styles/pages/contact.css";
import CountrySelector from "../components/contact/CountrySelector.astro";
import InterestSelector from "../components/contact/InterestSelector.astro";

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";
---

<Layout title="Servicios">
  <div class="main_wrapper">
    <div class="section_contact_hero">
      <div class="grid_wrapper">
        <div id="w-node-_16223885-9937-cea7-e81e-6a8ec43139bc-578cbd79" class="hero_content">
          <h1 gsap-anim-hero-heading="" class="heading_1">
            <div class="line" style="display: block; text-align: start; width: 100%;">
              <div class="word" style="display: inline-block;">
                <div class="char" style="display: inline-block; translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 0%);">
                  Contacto
                </div>
              </div>
            </div>
          </h1>
          <p gsap-anim-hero-text="" class="hero_text about_hero_text" style="opacity: 1;">
            ¿Tienes alguna duda o requieres más detalles? Te invitamos a llenar
            nuestro formulario de contacto, cuéntanos cómo podemos echarte la
            mano.
          </p>
        </div>
      </div>
      <div gsap-anim-hero-bg="" class="hero-background" style="opacity: 0;"></div>
    </div>
    <div class="section_contact">
      <div class="grid_wrapper">
        <div id="w-node-_44b001ab-5363-e9aa-925b-fdfdc691c4bf-578cbd79" class="blog_block">
          <h2 gsap-anim-letter="txtstragger" id="w-node-_44b001ab-5363-e9aa-925b-fdfdc691c4c1-578cbd79" class="heading_2-black">
            <div class="line" style="display: block; text-align: start; width: 100%;">
              <div class="word" style="display: inline-block;">
                <div class="char" style="display: inline-block; translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 0%); font-size:xxx-large">
                  Estamos aquí para ayudar
                </div>
              </div>
            </div>
          </h2>
          <div id="w-node-_44b001ab-5363-e9aa-925b-fdfdc691c4cd-578cbd79" class="our_blog w-dyn-list">
            <form
                id="form"
                class="needs-validation"
                novalidate
                data-recaptcha-site-key={recaptchaSiteKey}
            >
              <!-- Input Name -->
              <div class="mb-5">
                <label>
                  <input
                      type="text"
                      placeholder="Nombre"
                      required
                      class="contact_input"
                      name="nombre"
                  />
                </label>
                <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
                  Proporcione su nombre.
                </div>
              </div>

              <!-- Input Last Name -->
              <div class="mb-5">
                <label>
                  <input
                      type="text"
                      placeholder="Apellido"
                      required
                      class="contact_input"
                      name="apellido"
                  />
                </label>
                <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
                  Proporcione tu apellido.
                </div>
              </div>

              <!-- Input Mail-->
              <div class="mb-5">
                <label>
                  <input
                      id="email_address"
                      type="email"
                      placeholder="Correo electrónico"
                      name="correo"
                      required
                      class="contact_input"
                  />
                </label>
                <div class="empty-feedback text-red-400 text-sm mt-1">
                  Proporcione su dirección de correo electrónico.
                </div>
                <div class="invalid-feedback text-red-400 text-sm mt-1">
                  Por favor, introduzca su dirección de correo electrónico válida.
                </div>
              </div>

              <!-- Component Select Country -->
              <CountrySelector name="pais"/>

              <!-- Input Company -->
              <div class="mb-5">
                <label>
                  <input
                      id="company_name"
                      type="text"
                      placeholder="Compañía"
                      name="compania"
                      required
                      class="contact_input"
                  />
                </label>
                <div class="empty-feedback text-red-400 text-sm mt-1">
                  Proporcione el nombre de su compañía.
                </div>
              </div>

              <!-- Input interested-->
              <InterestSelector name="servicio"/>

              <!-- Input Message -->
              <div class="mb-3">
                <label>
                  <textarea
                      name="mensaje"
                      required
                      placeholder="¿Quieres añadir contexto a tu consulta? Añade una nota."
                      style="height: 10rem"
                      class="contact_input"
                  ></textarea>
                </label>
                <div class="empty-feedback invalid-feedback text-red-400 text-sm mt-1">
                  Por favor ingrese su mensaje.
                </div>
              </div>

              <!-- File Input -->
              <div class="mb-5">
                <label>
                  <span>Archivo adjunto (opcional):</span>
                  <input
                      type="file"
                      class="contact_input"
                      name="file"
                  />
                </label>
              </div>

              <div class="proceed_block">
                <div class="error_message_block">
                  <div class="w-embed">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 16.7307C12.2288 16.7307 12.4207 16.6533 12.5755 16.4985C12.7303 16.3437 12.8077 16.1519 12.8077 15.9231C12.8077 15.6942 12.7303 15.5024 12.5755 15.3476C12.4207 15.1928 12.2288 15.1154 12 15.1154C11.7711 15.1154 11.5793 15.1928 11.4245 15.3476C11.2697 15.5024 11.1923 15.6942 11.1923 15.9231C11.1923 16.1519 11.2697 16.3437 11.4245 16.4985C11.5793 16.6533 11.7711 16.7307 12 16.7307ZM11.25 13.0769H12.75V7.0769H11.25V13.0769ZM12.0017 21.5C10.6877 21.5 9.45268 21.2506 8.29655 20.752C7.1404 20.2533 6.13472 19.5765 5.2795 18.7217C4.42427 17.8669 3.74721 16.8616 3.24833 15.706C2.74944 14.5504 2.5 13.3156 2.5 12.0017C2.5 10.6877 2.74933 9.45268 3.248 8.29655C3.74667 7.1404 4.42342 6.13472 5.27825 5.2795C6.1331 4.42427 7.13834 3.74721 8.29398 3.24833C9.44959 2.74944 10.6844 2.5 11.9983 2.5C13.3122 2.5 14.5473 2.74933 15.7034 3.248C16.8596 3.74667 17.8652 4.42342 18.7205 5.27825C19.5757 6.1331 20.2527 7.13834 20.7516 8.29398C21.2505 9.44959 21.5 10.6844 21.5 11.9983C21.5 13.3122 21.2506 14.5473 20.752 15.7034C20.2533 16.8596 19.5765 17.8652 18.7217 18.7205C17.8669 19.5757 16.8616 20.2527 15.706 20.7516C14.5504 21.2505 13.3156 21.5 12.0017 21.5ZM12 20C14.2333 20 16.125 19.225 17.675 17.675C19.225 16.125 20 14.2333 20 12C20 9.76664 19.225 7.87498 17.675 6.32498C16.125 4.77498 14.2333 3.99998 12 3.99998C9.76664 3.99998 7.87498 4.77498 6.32498 6.32498C4.77498 7.87498 3.99998 9.76664 3.99998 12C3.99998 14.2333 4.77498 16.125 6.32498 17.675C7.87498 19.225 9.76664 20 12 20Z" fill="#B52437"></path>
                    </svg>
                  </div>
                  <div>Por favor complete todos los campos requeridos</div>
                </div>
                <button
                    id="proceed_3d"
                    gsap-anim-hero-btn=""
                    type="submit"
                    class="hero_button proceed_btn w-inline-block"
                >
                  <div class="btn-grid">
                    <div class="clip">
                      <div class="button_text_block">
                        <div class="button_text">Enviar</div>
                      </div>
                      <div class="button_text_block bottom">
                        <div class="button_text">Enviar</div>
                      </div>
                    </div>
                    <img
                        loading="lazy"
                        src="https://uploads-ssl.webflow.com/64748b66fa7c0d5993fc7935/64749cfc88727267a02516d5_button%20arrow.svg"
                        alt="Button white arrow"
                        class="button_arrow"
                    />
                  </div>
                </button>
              </div>
              <div id="result" class="mt-3 text-center"></div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

{recaptchaSiteKey && (
  <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} defer></script>
)}

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }

  .text-green-500 {
    color: #28a745;
  }

  .text-red-500 {
    color: #dc3545;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('form');
    const result = document.getElementById('result');
    const submitBtn = document.getElementById('proceed_3d');
    const buttonTexts = submitBtn.querySelectorAll('.button_text');
    const RECAPTCHA_SITE_KEY = form?.dataset.recaptchaSiteKey ?? '';

    const setSubmittingState = (isSubmitting) => {
      submitBtn.disabled = isSubmitting;
      buttonTexts.forEach((text) => {
        text.textContent = isSubmitting ? 'Enviando...' : 'Enviar';
      });
    };

    const requestRecaptchaToken = () => {
      if (!RECAPTCHA_SITE_KEY) {
        return Promise.reject(new Error('Falta configurar la variable PUBLIC_RECAPTCHA_SITE_KEY.'));
      }

      if (!window.grecaptcha) {
        return Promise.reject(new Error('No se pudo cargar reCAPTCHA.'));
      }

      return new Promise((resolve, reject) => {
        window.grecaptcha.ready(() => {
          window.grecaptcha
            .execute(RECAPTCHA_SITE_KEY, { action: 'submit' })
            .then(resolve)
            .catch(reject);
        });
      });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      result.innerHTML = '';

      form.classList.add('was-validated');
      if (!form.checkValidity()) {
        form.querySelector(':invalid').focus();
        return;
      }

      setSubmittingState(true);

      try {
        const formData = new FormData(form);
        const recaptchaToken = await requestRecaptchaToken();
        formData.append('recaptchaToken', recaptchaToken);

        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData
        });

        const payload = await response.json().catch(() => null);

        if (!response.ok) {
          throw new Error(payload?.message ?? 'Error al enviar el formulario');
        }

        result.innerHTML = `<p class="text-green-500">${payload?.message ?? '¡Mensaje enviado con éxito! Nos pondremos en contacto pronto.'}</p>`;
        form.reset();
        form.classList.remove('was-validated');
      } catch (error) {
        console.error('Error:', error);
        const errorMessage = error instanceof Error ? error.message : 'Error al enviar el mensaje. Por favor intente nuevamente.';
        result.innerHTML = `<p class="text-red-500">${errorMessage}</p>`;
      } finally {
        setSubmittingState(false);
        setTimeout(() => {
          result.innerHTML = '';
        }, 5000);
      }
    });
  });
</script>
