---
import Layout from "../layouts/Layout.astro";
import "../../src/styles/pages/contact.css";
import CountrySelector from "../components/contact/CountrySelector.astro";
import InterestSelector from "../components/contact/InterestSelector.astro";

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";
---

<Layout title="Contacto">
  <div class="main_wrapper">
    <div class="section_contact_hero">
      <div class="grid_wrapper">
        <div id="w-node-_16223885-9937-cea7-e81e-6a8ec43139bc-578cbd79" class="hero_content">
          <h1 gsap-anim-hero-heading="" class="heading_1">
            <div class="line" style="display: block; text-align: start; width: 100%;">
              <div class="word" style="display: inline-block;">
                <div class="char" style="display: inline-block; translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 0%);">
                  Contacto
                </div>
              </div>
            </div>
          </h1>
          <p gsap-anim-hero-text="" class="hero_text about_hero_text" style="opacity: 1;">
            ¿Tienes alguna duda o requieres más detalles? Te invitamos a llenar
            nuestro formulario de contacto, cuéntanos cómo podemos echarte la
            mano.
          </p>
        </div>
      </div>
      <div gsap-anim-hero-bg="" class="hero-background" style="opacity: 0;"></div>
    </div>
    <div class="section_contact">
      <div class="grid_wrapper">
        <div class="contact_layout">
          <div class="contact_form_block">
            <h2 class="heading_2-black contact_heading">
              Estamos aquí para ayudar
            </h2>
            <p class="contact_intro">Completa el formulario y nos pondremos en contacto contigo a la brevedad.</p>
            <form
                id="form"
                class="contact_form needs-validation"
                novalidate
                data-recaptcha-site-key={recaptchaSiteKey}
            >
              <div class="form_row form_row_split">
                <!-- Input Name -->
                <div class="form_field">
                  <label class="form_label">Nombre</label>
                  <input
                      type="text"
                      placeholder="Tu nombre"
                      required
                      class="contact_input"
                      name="nombre"
                  />
                  <div class="empty-feedback invalid-feedback form_error">
                    Proporcione su nombre.
                  </div>
                </div>

                <!-- Input Last Name -->
                <div class="form_field">
                  <label class="form_label">Apellido</label>
                  <input
                      type="text"
                      placeholder="Tu apellido"
                      required
                      class="contact_input"
                      name="apellido"
                  />
                  <div class="empty-feedback invalid-feedback form_error">
                    Proporcione tu apellido.
                  </div>
                </div>
              </div>

              <div class="form_row form_row_split">
                <div class="form_field">
                  <label class="form_label">Correo electrónico</label>
                  <input
                      id="email_address"
                      type="email"
                      placeholder="tu@email.com"
                      name="correo"
                      required
                      class="contact_input"
                  />
                  <div class="empty-feedback form_error">
                    Proporcione su correo electrónico.
                  </div>
                  <div class="invalid-feedback form_error">
                    Introduzca un correo válido.
                  </div>
                </div>
                <div class="form_field">
                  <CountrySelector />
                </div>
              </div>

              <div class="form_row form_row_split">
                <div class="form_field">
                  <label class="form_label">Compañía</label>
                  <input
                      id="company_name"
                      type="text"
                      placeholder="Nombre de tu empresa"
                      name="compania"
                      required
                      class="contact_input"
                  />
                  <div class="empty-feedback form_error">
                    Proporcione el nombre de su compañía.
                  </div>
                </div>
                <div class="form_field">
                  <InterestSelector />
                </div>
              </div>

              <div class="form_row form_row_inline">
                <div class="form_field form_field_full">
                  <label class="form_label">Mensaje</label>
                  <textarea
                      name="mensaje"
                      required
                      placeholder="Cuéntanos cómo podemos ayudarte..."
                      class="contact_input contact_textarea"
                      rows="3"
                  ></textarea>
                  <div class="empty-feedback invalid-feedback form_error">
                    Por favor ingrese su mensaje.
                  </div>
                </div>
                <div class="form_field form_field_side">
                  <label class="form_label">Archivo adjunto <span class="form_label_optional">(opcional)</span></label>
                  <label class="file_input_wrapper">
                    <input
                        type="file"
                        class="contact_file_input"
                        name="file"
                    />
                    <span class="file_input_label">
                      <svg class="file_input_icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                      </svg>
                      <span class="file_input_text" data-file-text>Seleccionar archivo</span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="form_submit_block">
                <button
                    id="proceed_3d"
                    type="submit"
                    class="contact_submit_btn"
                >
                  <span class="button_text">Enviar mensaje</span>
                  <svg class="btn_arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </button>
                <div id="result" class="form_result"></div>
              </div>
            </form>
          </div>

          <div class="contact_separator" aria-hidden="true"></div>

          <aside class="contact_info_block">
            <h3 class="contact_info_title">Otra forma de contactarnos</h3>
            <div class="contact_info_item">
              <span class="contact_info_icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <div>
                <span class="contact_info_label">Teléfono</span>
                <a href="tel:+524422252786" class="contact_info_value">(442) 225 27 86</a>
              </div>
            </div>
            <div class="contact_info_item">
              <span class="contact_info_icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <div>
                <span class="contact_info_label">Dirección</span>
                <a
                  href="https://maps.app.goo.gl/ordF95iNCRPSjqvJ7"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact_info_value contact_info_link"
                >
                  Av. las Rosas 314, Loma IX, 76117 San Pedro Martir, Qro.
                </a>
              </div>
            </div>
            <p class="contact_info_note">Respondemos en un plazo de 24-48 horas hábiles.</p>
          </aside>
        </div>
      </div>
    </div>
  </div>
</Layout>

{recaptchaSiteKey && (
  <script src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`} defer></script>
)}

<style>
  .text-green-500 {
    color: #28a745;
  }

  .text-red-500 {
    color: #dc3545;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.querySelector('.contact_file_input');
    const fileTextEl = document.querySelector('[data-file-text]');
    const fileWrapper = document.querySelector('.file_input_wrapper');

    if (fileInput && fileTextEl && fileWrapper) {
      fileInput.addEventListener('change', () => {
        const name = fileInput.files?.[0]?.name;
        fileTextEl.textContent = name || 'Seleccionar archivo';
        fileWrapper.classList.toggle('has-file', !!name);
      });
    }

    const form = document.getElementById('form');
    const result = document.getElementById('result');
    const submitBtn = document.getElementById('proceed_3d');
    const buttonTexts = submitBtn.querySelectorAll('.button_text');
    const RECAPTCHA_SITE_KEY = form?.dataset.recaptchaSiteKey ?? '';

    const setSubmittingState = (isSubmitting) => {
      submitBtn.disabled = isSubmitting;
      buttonTexts.forEach((text) => {
        text.textContent = isSubmitting ? 'Enviando...' : 'Enviar';
      });
    };

    const requestRecaptchaToken = () => {
      if (!RECAPTCHA_SITE_KEY) {
        return Promise.reject(new Error('Falta configurar la variable PUBLIC_RECAPTCHA_SITE_KEY.'));
      }

      if (!window.grecaptcha) {
        return Promise.reject(new Error('No se pudo cargar reCAPTCHA.'));
      }

      return new Promise((resolve, reject) => {
        window.grecaptcha.ready(() => {
          window.grecaptcha
            .execute(RECAPTCHA_SITE_KEY, { action: 'submit' })
            .then(resolve)
            .catch(reject);
        });
      });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      result.innerHTML = '';

      form.classList.add('was-validated');
      if (!form.checkValidity()) {
        form.querySelector(':invalid').focus();
        return;
      }

      setSubmittingState(true);

      try {
        const formData = new FormData(form);
        const recaptchaToken = await requestRecaptchaToken();
        formData.append('recaptchaToken', recaptchaToken);

        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData
        });

        const payload = await response.json().catch(() => null);

        if (!response.ok) {
          throw new Error(payload?.message ?? 'Error al enviar el formulario');
        }

        result.innerHTML = `<p class="text-green-500">${payload?.message ?? '¡Mensaje enviado con éxito! Nos pondremos en contacto pronto.'}</p>`;
        form.reset();
        form.classList.remove('was-validated');
      } catch (error) {
        console.error('Error:', error);
        const errorMessage = error instanceof Error ? error.message : 'Error al enviar el mensaje. Por favor intente nuevamente.';
        result.innerHTML = `<p class="text-red-500">${errorMessage}</p>`;
      } finally {
        setSubmittingState(false);
        setTimeout(() => {
          result.innerHTML = '';
        }, 5000);
      }
    });
  });
</script>
