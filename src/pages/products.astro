  <script>
    function slider() {
      let splides = $(".service_slider, .mobile_process_slider");
      for (let i = 0, splideLength = splides.length; i < splideLength; i++) {
        new Splide(splides[i], {
          type: "slide",
          direction: "horizontal",
          slidesPerView: "auto",
          keyboard: true,
          freeMode: true,
          centeredSlides: true,
          mousewheel: true,
          breakpoints: {
            991: { slidesPerView: 3 },
            480: { slidesPerView: 3 },
            768: { slidesPerView: 3 },
          },
          speed: 300,
        }).mount();
      }
    }

    slider();

    function testimonial_splide() {
      let splides = $(".testimonial_splide");
      for (let i = 0, splideLength = splides.length; i < splideLength; i++) {
        new Splide(splides[i], {
          type: "slide",
          direction: "horizontal",
          slidesPerView: "auto",
          keyboard: true,
          freeMode: true,
          centeredSlides: true,
          mousewheel: true,
          breakpoints: {
            991: { slidesPerView: 3 },
            480: { slidesPerView: 3 },
            768: { slidesPerView: 3 },
          },
          speed: 300,
        }).mount();
      }
    }

    testimonial_splide();

    // Montar galerías de servicio solo si existen en la página
    [1, 2, 3, 4, 5].forEach(function (i) {
      var el = document.querySelector(".gallery_service-" + i);
      if (el) {
        var splide = new Splide(".gallery_service-" + i);
        var bar = splide.root.querySelector(".gallery_progress_bar-" + i);
        if (bar) {
          splide.on("mounted move", function () {
            var end = splide.Components.Controller.getEnd() + 1;
            bar.style.width = String((100 * (splide.index + 1)) / end) + "%";
          });
        }
        splide.mount();
      }
    });

    function slider1() {
      let splides = $(".slider-1, .slider-2, .slider-3, .slider-4, .slider-5");
      for (let i = 0, splideLength = splides.length; i < splideLength; i++) {
        new Splide(splides[i], {
          type: "slide",
          direction: "horizontal",
          slidesPerView: "auto",
          keyboard: true,
          freeMode: true,
          centeredSlides: true,
          mousewheel: true,
          breakpoints: {
            991: { slidesPerView: 3 },
            480: { slidesPerView: 3 },
            768: { slidesPerView: 3 },
          },
          speed: 300,
        }).mount();
      }
    }

    slider1();
  </script>

  <!-- Mobile Services tab -->
  <script>
    $(window).scroll(function () {
      var stickyTop = $(".mobile_service_tab").offset().top;
      if ($(this).scrollTop() >= stickyTop) {
        $(".mobile_service_tab").addClass("active");
      } else {
        $(".mobile_service_tab").removeClass("active");
      }
    });
  </script>

  <!-- Indicador de sección activa según scroll -->
  <script>
    (function () {
      var sections = document.querySelectorAll(".services_content .service_block-one[id]");
      var desktopLinks = document.querySelectorAll(".services_tab .service_tab-link[href^='#']");
      var mobileLinks = document.querySelectorAll(".mobile_service_tab .mobile_service_tab-link[href^='#']");
      if (!sections.length || (!desktopLinks.length && !mobileLinks.length)) return;

      function setActive(hash) {
        var allLinks = Array.from(desktopLinks).concat(Array.from(mobileLinks));
        allLinks.forEach(function (link) {
          link.classList.toggle("w--current", link.getAttribute("href") === hash);
        });
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var id = entry.target.id;
            if (id) setActive("#" + id);
          });
        },
        { rootMargin: "-20% 0px -60% 0px", threshold: 0 }
      );

      sections.forEach(function (sec) {
        if (sec.id) observer.observe(sec);
      });

      if (window.location.hash) setActive(window.location.hash);
    })();
  </script>

  <!-- Scroll con offset al navegar entre productos - evita que el navbar tape el contenido -->
  <script>
    (function () {
      var navOffset = 180;
      function scrollToSection(hash) {
        if (!hash || hash === "#") return;
        var target = document.querySelector(hash);
        if (target) {
          var top = target.getBoundingClientRect().top + window.scrollY - navOffset;
          window.scrollTo({ top: Math.max(0, top), behavior: "smooth" });
        }
      }
      document.addEventListener("click", function (e) {
        var link = e.target.closest("a.service_tab-link, a.mobile_service_tab-link");
        if (!link) return;
        var href = link.getAttribute("href");
        if (href && href.startsWith("#") && href.length > 1) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          scrollToSection(href);
          document.querySelectorAll(".service_tab-link, .mobile_service_tab-link").forEach(function (l) {
            l.classList.toggle("w--current", l.getAttribute("href") === href);
          });
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, "", href);
          }
          return false;
        }
      }, true);
      document.addEventListener("DOMContentLoaded", function () {
        if (window.location.hash) {
          setTimeout(function () {
            scrollToSection(window.location.hash);
          }, 100);
        }
      });
      if (document.readyState !== "loading" && window.location.hash) {
        setTimeout(function () {
          scrollToSection(window.location.hash);
        }, 150);
      }
    })();
  </script>
</Layout>
