---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Checking from "../assets/img/products/Checking.jpg";
import Welding from "../assets/img/products/welding.jpg";
import Holding from "../assets/img/products/holding.JPG";
import Assembly from "../assets/img/products/assembly.jpg";
import Assembly2 from "../assets/img/products/assembly2.JPG";
import Poka from "../assets/img/products/poka.jpg";
import Components from "../assets/img/products/components.jpg";
import Metalwork from "../assets/img/products/metalwork.jpg";
