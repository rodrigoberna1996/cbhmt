                class="service_image_block"
              >
              <Image src={Handling} alt="Sistemas automatizados" width={800} height={450} loading="lazy" />
              </div>
              <div
                id="w-node-_5be18822-ad16-4093-c929-f38c615561c3-578cbd7c"
