            <a href="#checking-fixture" class="mobile_service_tab-link">Checking fixture</a>
            <a href="#welding-fixture" class="mobile_service_tab-link">Welding fixture</a>
            <a href="#holding-fixture" class="mobile_service_tab-link">Holding fixture</a>
            <a href="#assembly-fixture" class="mobile_service_tab-link">Assembly fixture</a>
            <a href="#poka-yoke" class="mobile_service_tab-link">Poka-Yoke</a>
