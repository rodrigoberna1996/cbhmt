---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Diseno from "../assets/img/services/diseno.JPG";
import Diseno2 from "../assets/img/services/diseno2.JPG";
import EngineeringChanges from "../assets/img/services/engineering-changes.JPG";
import Integracion from "../assets/img/services/integracion.jpg";
import Integracion2 from "../assets/img/services/integracion2.jpg";
import SerialMachining from "../assets/img/services/serial-machining.JPG";
import SerialMachining2 from "../assets/img/services/serial-machining2.JPG";
import PartsRepairsMachining from "../assets/img/services/parts-and-repairs-machining.jpg";
import Programing from "../assets/img/services/programing.png";
import Programing2 from "../assets/img/services/programing2.JPG";
import FaroArm from "../assets/img/services/faro-arm.JPG";
import Accredited from "../assets/img/services/accredited.JPG";
import Accredited2 from "../assets/img/services/accredited2.JPG";
import Maintenance from "../assets/img/services/maintenance.JPG";
import Calibration from "../assets/img/services/calibration.JPG";
---

<Layout title="Servicios">
  <div class="main_wrapper">
    <div class="section_resource_hero">
      <div class="grid_wrapper">
        <div
          id="w-node-_16223885-9937-cea7-e81e-6a8ec43139bc-578cbd79"
          class="hero_content"
        >
          <h1 gsap-anim-hero-heading="" class="heading_1">
            <div
              class="line"
              style="display: block; text-align: start; width: 100%;"
            >
              <div class="word" style="display: inline-block;">
                <div
                  class="char"
                  style="display: inline-block; translate: none; rotate: none; scale: none; opacity: 1; transform: translate(0px, 0%);"
                >
                  Servicios
                </div>
              </div>
            </div>
          </h1>
          <p
            gsap-anim-hero-text=""
            class="hero_text about_hero_text"
            style="opacity: 1;"
          >
            Transformamos tu operación con soluciones que sincronizan sistemas y
            automatizan procesos clave. Descubre la eficiencia redefinida para
            un flujo de trabajo sin complicaciones.
          </p>
        </div>
      </div>
      <div gsap-anim-hero-bg="" class="hero-background" style="opacity: 0;">
      </div>
    </div>
    <div class="section_services_list">
      <div class="service_code w-embed">
        <style>
          a.service_tab-link.w--current {
            color: #b52437;
            transition: 0.5s ease;
          }

          .service_slider .splide__slide {
            width: 46% !important;
          }

          .section_services_list {
            contain: paint;
          }

          .mobile_service_tab.active {
            box-shadow: 0 10px 50px rgba(21, 21, 21, 0.1);
          }

          .mobile_service_tab::-webkit-scrollbar {
            width: 0 !important;
            display: none;
          }

          @media only screen and (max-width: 768px) {
            .service_slider .splide__slide {
              width: 70% !important;
            }
          }

          @media only screen and (max-width: 767px) {
            .service_slider .splide__slide {
              width: 100% !important;
            }
          }
        </style>
      </div>
      <div gsap-anim-fade="" class="mobile_service_tab">
        <a href="/#mechanical-design" class="mobile_service_tab-link"
          >Diseño mecánico</a
        ><a href="/#engineering-changes" class="mobile_service_tab-link">Cambios de ingeniería</a
        ><a href="/#integration-services" class="mobile_service_tab-link">Integración</a
        ><a href="/#serial-machining" class="mobile_service_tab-link">Maquinado en serie</a>
        <a href="/#parts-and-repairs-machining" class="mobile_service_tab-link">Maquinado de piezas y refacciones mecánicas</a>
        <a href="/#plc-robot-programming" class="mobile_service_tab-link">Programación de PLC y robots</a>
        <a href="/#faro-arm-measurement" class="mobile_service_tab-link">Medición con brazo faro</a>
        <a href="/#accredited-measurement" class="mobile_service_tab-link">Medición con organismo acreditado</a>
        <a href="/#tooling-maintenance" class="mobile_service_tab-link">Mantenimientos industriales de herramentales y celdas de soldadura</a>
        <a href="/#naams-calibration" class="mobile_service_tab-link">Calibración de herramentales con accesorios de ajustes NAAMS</a>
      </div>
      <div class="services_grid">
        <div
          id="w-node-_89edd147-3c53-bc50-b2be-f33079da3d09-578cbd7c"
          class="services_tab_block"
        >
          <div gsap-anim-fadeup="" class="services_tab">
            <a href="#mechanical-design" class="service_tab-link"
              >Diseño mecánico</a
            ><a href="#engineering-changes" class="service_tab-link"
              >Cambios de ingeniería</a
            ><a href="#integration-services" class="service_tab-link"
              >Integración</a
            ><a href="#serial-machining" class="service_tab-link"
              >Maquinado en serie</a
            ><a href="#parts-and-repairs-machining" class="service_tab-link"
              >Maquinado de piezas y refacciones mecánicas</a
            ><a href="#plc-robot-programming" class="service_tab-link"
              >Programación de PLC y robots</a
            ><a href="#faro-arm-measurement" class="service_tab-link"
              >Medición con brazo Faro</a
            ><a href="#accredited-measurement" class="service_tab-link"
              >Medición con organismo acreditado</a
            ><a href="#tooling-maintenance" class="service_tab-link"
              >Mantenimientos industriales de herramentales y celdas de soldadura</a
            ><a href="#naams-calibration" class="service_tab-link"
              >Calibración de herramentales con accesorios de ajustes NAAMS</a
            ><a href="/contact" class="get_a_quote_btn_block w-inline-block">
              <div class="btn-grid">
                <div class="clip">
                  <div class="button_text_block">
                    <div class="sub_button-text">Obtén tu cotización</div>
                  </div>
                  <div class="button_text_block bottom">
                    <div class="sub_button-text">Obtén tu cotización</div>
                  </div>
                </div>
                <div class="sub_button-arrow w-embed">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="9"
                    viewbox="0 0 20 9"
                    fill="none"
                  >
                    <rect
                      y="4"
                      width="14"
                      height="1"
                      fill="#151515"
                      fill-opacity="0.6"></rect>
                    <path
                      d="M14 8V1L19.5 4.5L14 8Z"
                      fill="#151515"
                      fill-opacity="0.6"
                      stroke="#151515"
                      stroke-opacity="0.6"
                      stroke-width="0.2"></path>
                  </svg>
                </div>
              </div>
              <div class="sub_button-line"></div>
            </a>
          </div>
          <div class="service_title_block">
            <h2 gsap-anim-letter="txtstragger" class="heading_2-black">
              Explorar todo
            </h2>
            <a href="/services" class="get_a_quote_btn_block w-inline-block">
              <div class="btn-grid">
                <div class="clip">
                  <div class="button_text_block">
                    <div class="sub_button-text">Obtén tu cotización</div>
                  </div>
                  <div class="button_text_block bottom">
                    <div class="sub_button-text">Obtén tu cotización</div>
                  </div>
                </div>
                <div class="sub_button-arrow w-embed">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="9"
                    viewbox="0 0 20 9"
                    fill="none"
                  >
                    <rect
                      y="4"
                      width="14"
                      height="1"
                      fill="#151515"
                      fill-opacity="0.6"></rect>
                    <path
                      d="M14 8V1L19.5 4.5L14 8Z"
                      fill="#151515"
                      fill-opacity="0.6"
                      stroke="#151515"
                      stroke-opacity="0.6"
                      stroke-width="0.2"></path>
                  </svg>
                </div>
              </div>
              <div class="sub_button-line"></div>
            </a>
          </div>
        </div>
        <div
          id="w-node-fd635576-8b21-b573-bc32-d5a0270e6ca2-578cbd7c"
          class="services_content">
          <div id="mechanical-design" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one">               
                <Image src={Diseno} alt="" />
                <Image src={Diseno2} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                  Diseño mecánico
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    CBH Mechatooling cuenta con más de 12 años de experiencia en
                    el diseño integral de herramentales llave en mano para la
                    industria automotriz, desde la conceptualización hasta la
                    implementación en planta, asegurando soluciones precisas,
                    eficientes y de alta calidad.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="engineering-changes" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={EngineeringChanges} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                    Cambios de ingeniería
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Mejoramos tus herramentales para ofrecer un mejor rendimiento mejorando el proceso productivo,
                     mediante el análisis del modelo CAD y adaptamos tus herramentales ante cambios de diseño de producto final.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="integration-services" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={Integracion} alt="" />
              <Image src={Integracion2} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                    Integración
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    CBH Mechatooling tiene el objetivo ofrecer a nuestros clientes soluciones en integraciones para conectar, 
                    controlar, gestionar sistemas, procesos o dispositivos de forma automatizada, reduciendo la intervención humana
                     y mejorando la eficiencia para reducción de errores y la mejora de la productividad, implementando robots, 
                     sistemas de visión y sistemas de trazabilidad.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="serial-machining" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={SerialMachining} alt="" />
              <Image src={SerialMachining2} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                 Maquinado en serie
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Ofrecemos servicios de maquinado en serie para la producción de piezas mecánicas, 
                    caracterizados por su eficiencia y alta precisión. Fabricamos en acero, aluminio, cobre, 
                    plásticos de ingeniería, adaptándonos a planos, muestras o diseños personalizados.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="parts-and-repairs-machining" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={PartsRepairsMachining} alt="" />
              
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                    Maquinado de piezas y refacciones mecánicas
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Ofrecemos servicios de maquinado de piezas y refacciones mecánicas utilizando 
                    herramientas de corte operadas por maquinaria CNC y convencional, garantizando 
                    precisión y calidad.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="plc-robot-programming" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={Programing} alt="" />
              <Image src={Programing2} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                   Programación de PLC y robots (Fanuc, Yaskawa)
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Contamos con ingenieros certificados y experimentados en FANUC y Yaskawa, 
                    quienes poseen las competencias necesarias para implementar, ajustar y optimizar 
                    configuraciones complejas en sistemas de automatización industrial. 
                    Con amplia experiencia en programación, mantenimiento y ajuste de robots y sistemas de control, 
                    nuestros ingenieros aseguran que las soluciones se adapten perfectamente a las especificaciones de cada cliente, 
                    mejorando la eficiencia operativa y reduciendo los tiempos de inactividad.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="faro-arm-measurement" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={FaroArm} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                   Medición con brazo faro
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Contamos con un equipo de medición de la marca FARO, el cual nos permite realizar 
                    mediciones punto por punto de nuestros productos fabricados, capturando dimensiones, 
                    geometrías y tolerancias con gran exactitud. Además, disponemos de personal capacitado 
                    y del equipo calibrado para garantizar mediciones confiables y trazables.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="accredited-measurement" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={Accredited} alt="" />
              <Image src={Accredited2} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                  Medición con organismo acreditado
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Trabajamos en conjunto con un organismo acreditado, que demuestra su competencia técnica y confiabilidad, 
                    lo que garantiza la calidad y validez de la medición, asegurando resultados confiables, trazables y válidos 
                    para auditorías o certificaciones
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="tooling-maintenance" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45b-578cbd7c"
                class="service_image_block-one"
              >
              <Image src={Maintenance} alt="" />
              </div>
              <div
                id="w-node-_39193eb8-dc62-5091-c256-45b51f84b45c-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                  Mantenimientos industriales de herramentales y celdas de soldadura
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Brindamos servicios de mantenimiento industrial de herramentales y celdas de soldadura, 
                    como fixtures, que incluyen la revisión, limpieza y reparación de equipos, 
                    con el objetivo de garantizar la continuidad operativa, la calidad del proceso y 
                    prolongar la vida útil de los herramentales.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
          <div id="naams-calibration" class="service_block-one">
            <div class="service_detail_grid">
              <div
                gsap-anim-fadeup=""
                id="w-node-_2714077d-5f4b-2b6b-6a08-8f5b539c607d-578cbd7c"
                class="service_image_block-three"
              >
              <Image src={Calibration} alt="" />
              </div>
              <div
                id="w-node-_2714077d-5f4b-2b6b-6a08-8f5b539c607e-578cbd7c"
                class="service_content_block"
              >
                <h2 gsap-anim-letter="txtstragger" class="service_title">
                  Calibración de herramentales con accesorios de ajustes NAAMS
                </h2>
                <div gsap-anim-fadeup="" class="service_details-block">
                  <div class="service_text service_detail_block">
                    Todas nuestras herramientas fabricadas están equipadas con accesorios de ajuste 
                    NAAMS (North American Automotive Metric Standard), lo que garantiza que los procesos de medición 
                    y apriete cumplan con los estándares de calidad exigidos por nuestros clientes, en aspectos como repetibilidad, 
                    alineación, precisión geométrica, posición, altura, paralelismo y perpendicularidad. Esto contribuye a mantener 
                    la estabilidad y consistencia en los procesos de soldadura y ensamble, reduciendo retrabajos y errores por una deficiente alineación.
                  </div>
                  <div class="service-line"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          id="w-node-fca0c1bb-0abb-87f7-92fa-b7a338cfa69e-578cbd7c"
          class="left_bg_block"
        >
        </div>
      </div>
    </div>
  </div>

  <script>
    function slider() {
      let splides = $(".service_slider, .mobile_process_slider");
      for (let i = 0, splideLength = splides.length; i < splideLength; i++) {
        new Splide(splides[i], {
          type: "slide",
          direction: "horizontal",
          slidesPerView: "auto",
          keyboard: true,
          freeMode: true,
          centeredSlides: true,
          mousewheel: true,
          breakpoints: {
            991: { slidesPerView: 3 },
            480: { slidesPerView: 3 },
            768: { slidesPerView: 3 },
          },
          speed: 300,
        }).mount();
      }
    }

    slider();

    function testimonial_splide() {
      let splides = $(".testimonial_splide");
      for (let i = 0, splideLength = splides.length; i < splideLength; i++) {
        new Splide(splides[i], {
          type: "slide",
          direction: "horizontal",
          slidesPerView: "auto",
          keyboard: true,
          freeMode: true,
          centeredSlides: true,
          mousewheel: true,
          breakpoints: {
            991: { slidesPerView: 3 },
            480: { slidesPerView: 3 },
            768: { slidesPerView: 3 },
          },
          speed: 300,
        }).mount();
      }
    }

    testimonial_splide();

    // All service gallery slider
    var splide1 = new Splide(".gallery_service-1");
    var bar1 = splide1.root.querySelector(".gallery_progress_bar-1");
    // Update the bar width:
    splide1.on("mounted move", function () {
      var end = splide1.Components.Controller.getEnd() + 1;
      bar1.style.width = String((100 * (splide1.index + 1)) / end) + "%";
    });
    splide1.mount();

    var splide2 = new Splide(".gallery_service-2");
    var bar2 = splide2.root.querySelector(".gallery_progress_bar-2");

    splide2.on("mounted move", function () {
      var end = splide2.Components.Controller.getEnd() + 1;
      bar2.style.width = String((100 * (splide2.index + 1)) / end) + "%";
    });
    splide2.mount();

    var splide3 = new Splide(".gallery_service-3");
    var bar3 = splide3.root.querySelector(".gallery_progress_bar-3");

    splide3.on("mounted move", function () {
      var end = splide3.Components.Controller.getEnd() + 1;
      bar3.style.width = String((100 * (splide3.index + 1)) / end) + "%";
    });
    splide3.mount();

    var splide4 = new Splide(".gallery_service-4");
    var bar4 = splide4.root.querySelector(".gallery_progress_bar-4");

    splide4.on("mounted move", function () {
      var end = splide4.Components.Controller.getEnd() + 1;
      bar4.style.width = String((100 * (splide4.index + 1)) / end) + "%";
    });
    splide4.mount();

    var splide5 = new Splide(".gallery_service-5");
    var bar5 = splide5.root.querySelector(".gallery_progress_bar-5");

    splide5.on("mounted move", function () {
      var end = splide5.Components.Controller.getEnd() + 1;
      bar5.style.width = String((100 * (splide5.index + 1)) / end) + "%";
    });
    splide5.mount();

    function slider1() {
      let splides = $(".slider-1, .slider-2, .slider-3, .slider-4, .slider-5");
      for (let i = 0, splideLength = splides.length; i < splideLength; i++) {
        new Splide(splides[i], {
          type: "slide",
          direction: "horizontal",
          slidesPerView: "auto",
          keyboard: true,
          freeMode: true,
          centeredSlides: true,
          mousewheel: true,
          breakpoints: {
            991: { slidesPerView: 3 },
            480: { slidesPerView: 3 },
            768: { slidesPerView: 3 },
          },
          speed: 300,
        }).mount();
      }
    }

    slider1();
  </script>

  <!-- Mobile Services tab -->
  <script>
    $(window).scroll(function () {
      var stickyTop = $(".mobile_service_tab").offset().top;
      if ($(this).scrollTop() >= stickyTop) {
        $(".mobile_service_tab").addClass("active");
      } else {
        $(".mobile_service_tab").removeClass("active");
      }
    });
  </script>
</Layout>
