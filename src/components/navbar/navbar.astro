---
import { Image } from "astro:assets";
import Logo from "../../../public/img/logo.png";
import FacebookIcon from "../../../public/img/fb.svg";
import InstagramIcon from "../../../public/img/ins.svg";
import LinkedInIcon from "../../../public/img/linkedin.svg";
import "../../styles/components/navbar.css";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`) || path.startsWith(`${href}#`);
const inSection = (prefix: string) => path.startsWith(prefix);

const serviceLinks = [
  { href: "/services#mechanical-design", label: "Diseño mecánico" },
  { href: "/services#engineering-changes", label: "Cambios de ingeniería" },
  { href: "/services#integration-services", label: "Integración" },
  { href: "/services#serial-machining", label: "Maquinado en serie" },
  { href: "/services#parts-and-repairs-machining", label: "Maquinado de piezas y refacciones mecánicas" },
  { href: "/services#plc-robot-programming", label: "Programación de PLC y robots" },
  { href: "/services#faro-arm-measurement", label: "Medición con brazo Faro" },
  { href: "/services#accredited-measurement", label: "Medición con organismo acreditado" },
  { href: "/services#tooling-maintenance", label: "Mantenimientos industriales de herramentales y celdas de soldadura" },
  { href: "/services#naams-calibration", label: "Calibración de herramentales con accesorios de ajustes NAAMS" },
];

const productLinks = [
  { href: "/products#checking-fixture", label: "Checking fixture" },
  { href: "/products#welding-fixture", label: "Welding fixture" },
  { href: "/products#holding-fixture", label: "Holding fixture" },
  { href: "/products#assembly-fixture", label: "Assembly fixture" },
  { href: "/products#poka-yoke", label: "Poka-Yoke" },
  { href: "/products#mechanical-components", label: "Complementos mecánicos" },
  { href: "/products#industrial-metalwork", label: "Pailería industrial" },
  { href: "/products#special-equipment-sales", label: "Venta de equipos especiales" },
  { href: "/products#automated-handling-systems", label: "Sistemas automatizados" },
];

const chunkLinks = (links: { href: string; label: string }[], columns = 2) => {
  const size = Math.ceil(links.length / columns);
  return Array.from({ length: columns }, (_, index) =>
    links.slice(index * size, (index + 1) * size)
  ).filter((column) => column.length > 0);
};

const serviceGroups = chunkLinks(serviceLinks, 2);
const productGroups = chunkLinks(productLinks, 2);
---

<div gsap-anim-nav="" class="nav-bar">
  <div class="nav_grid_wrapper">
    <div
      id="w-node-e63e5f88-269c-02fc-ffde-393cb66b54f6-b66b54f4"
      class="nav_grid"
    >
      <div class="nav_logo_container">
        <a
          id="w-node-e63e5f88-269c-02fc-ffde-393cb66b54f7-b66b54f4"
          href="/"
          aria-current="page"
          class="logo_link w-inline-block w--current"
        >
          <Image
            src={Logo}
            alt="logo-cbhmt"
            class="logo_link_img"
            loading="lazy"
          />
        </a>
        <div class="navbar_social_block">
          <a href="https://www.linkedin.com/company/cbh-mechatooling/" target="_blank" class="social_media_circle">
            <Image src={LinkedInIcon} alt="linkedin" loading="lazy" width={16} height={16} />
          </a>
          <a href="https://www.instagram.com/cbh.mechatooling/" target="_blank" class="social_media_circle">
            <Image src={InstagramIcon} alt="instagram" loading="lazy" width={16} height={16} />
          </a>
          <a href="https://www.facebook.com/cbh.mechatooling.5" target="_blank" class="social_media_circle">
            <Image src={FacebookIcon} alt="facebook" loading="lazy" width={8} height={16} />
          </a>
        </div>
      </div>
      <div
        id="w-node-e63e5f88-269c-02fc-ffde-393cb66b54f9-b66b54f4"
        class="nav_links_block"
      >
        <a href="/about" class={"nav_link" + (isCurrent("/about") ? " w--current" : "")}
          >Acerca de</a
        >
        <div
          data-hover="false"
          data-delay="0"
          class="language_dropdown w-dropdown"
        >
          <div class={"language_dropdown_toggle w-dropdown-toggle" + (inSection("/services") ? " current" : "")}>
            <div>Servicios</div>
            <div class="w-icon-dropdown-toggle"></div>
          </div>
          <nav
            class="language_dropdown_list w-dropdown-list"
            style={`--dropdown-columns:${serviceGroups.length};--dropdown-max-width:720px;--dropdown-column-width:360px;--dropdown-column-min:220px;`}
          >
            <div class="dropdown_panel">
              {serviceGroups.map((column, columnIndex) => (
                <div class="dropdown_column" key={`services-col-${columnIndex}`}>
                  <ul class="dropdown_list">
                    {column.map((link) => (
                      <li key={link.href}>
                        <a href={link.href} class="language_dropdown_link w-dropdown-link">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </nav>
        </div>
        <div
          data-hover="false"
          data-delay="0"
          class="language_dropdown w-dropdown"
        >
          <div class={"language_dropdown_toggle w-dropdown-toggle" + (inSection("/products") ? " current" : "")}>
            <div>Productos</div>
            <div class="w-icon-dropdown-toggle"></div>
          </div>
          <nav
            class="language_dropdown_list w-dropdown-list"
            style={`--dropdown-columns:${productGroups.length};--dropdown-max-width:560px;--dropdown-column-width:280px;--dropdown-column-min:200px;`}
          >
            <div class="dropdown_panel">
              {productGroups.map((column, columnIndex) => (
                <div class="dropdown_column" key={`products-col-${columnIndex}`}>
                  <ul class="dropdown_list">
                    {column.map((link) => (
                      <li key={link.href}>
                        <a href={link.href} class="language_dropdown_link w-dropdown-link">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </nav>
        </div>
        <a href="/contact" class={"nav_link" + (isCurrent("/contact") ? " w--current" : "")}>Contacto</a>
      </div>
      <div
        id="w-node-_3f571d52-b65f-917c-24da-08674beefd9e-b66b54f4"
        class="mobile_right_block"
      >
        <div
          id="w-node-e63e5f88-269c-02fc-ffde-393cb66b5502-b66b54f4"
          class="mobile_toggle_block"
        >
          <img
            src="https://uploads-ssl.webflow.com/64748b66fa7c0d5993fc7935/6481c033468140038c23d232_menu%20toggle%20icon.svg"
            loading="lazy"
            alt=""
            class="mobile_menu_icon menu-dots"
          />
          <img
            src="https://uploads-ssl.webflow.com/64748b66fa7c0d5993fc7935/647f3167116836b758c81807_close_FILL0_wght400_GRAD0_opsz48.svg"
            loading="lazy"
            alt=""
            class="mobile_menu_icon menu-close"
          />
        </div>
      </div>
    </div>
  </div>
  <div class="mobile_menu_wrapper">
    <a href="/about" class="mobile_link_text link1">Acerca de</a>
    <a href="/services" class="mobile_link_text link1">Servicios</a>
    <a href="/products" class="mobile_link_text link1">Productos</a>
    <a href="/contact" class="mobile_link_text link4">Contacto</a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.nav-bar');
    const toggle = document.querySelector('.mobile_toggle_block');
    const mobileLinks = document.querySelectorAll('.mobile_menu_wrapper a');
    const body = document.body;

    const closeMenu = () => {
      nav?.classList.remove('menu-open');
      body.classList.remove('no-scroll');
    };

    const openMenu = () => {
      nav?.classList.add('menu-open');
      body.classList.add('no-scroll');
    };

    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        if (nav.classList.contains('menu-open')) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    }

    mobileLinks.forEach((a) => a.addEventListener('click', closeMenu));

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
      }
    });

    const mediaQuery = window.matchMedia('(min-width: 992px)');
    const handleViewportChange = (event) => {
      if (event.matches) {
        closeMenu();
      }
    };
    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener('change', handleViewportChange);
    } else if (mediaQuery.addListener) {
      mediaQuery.addListener(handleViewportChange);
    }

    const onScroll = () => {
      if (!nav) return;
      const scrolled = window.scrollY > 10;
      nav.classList.toggle('is-sticky', scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  });
  </script>
