                  sizes="(max-width: 991px) 100vw, (max-width: 1279px) 1vw, (max-width: 1439px) 100vw, (max-width: 1919px) 1vw, 66px"
                  srcset="https://uploads-ssl.webflow.com/64758c43eeea08d132443267/64758c743a99deaf4e5a1129_Image_20230424173334-p-500.png 500w, https://uploads-ssl.webflow.com/64758c43eeea08d132443267/64758c743a99deaf4e5a1129_Image_20230424173334.png 600w"
