---
import "../styles/components/galery.css"
---
<div class="section_company_images">
  <div class="grid_wrapper">
    <div id="w-node-e37e644d-1507-881e-96ee-995dfe3b2cb4-578cbd69" class="capability_image_title_block">
      <h2 gsap-anim-letter="txtstragger" id="w-node-f8f223b0-fbe3-88e0-0f23-ffd7e2e39d03-578cbd69"
          class="heading_2-white">Capacidad de fábrica</h2>
      <div id="w-node-_4a0e87b2-6caa-1aeb-9279-f8723608bf23-578cbd69" class="splide slider">
        <div class="splide_embed w-embed">
          <style>
            .slider .splide__arrows,
            .slider .splide__pagination {
              display: none;
            }

            .my-slider-progress-bar {
              transition: width 400ms ease;
              width: 0;
            }

            .section_company_images .slider .splide__slide {
              width: 40% !important;
            }

            @media only screen and (max-width: 768px) {
              .section_company_images .slider .splide__slide {
                width: 70% !important;
              }
            }

            @media only screen and (max-width: 767px) {
              .section_company_images .slider .splide__slide {
                width: 90% !important;
              }
            }
          </style>
        </div>
        <div class="splide__track w-dyn-list">
          <div role="list" class="splide__list w-dyn-items">
            <div gsap-anim-fade="" role="listitem" class="splide__slide w-dyn-item">
              <div class="company_image_wrapper"><img
                  src="https://uploads-ssl.webflow.com/64758c43eeea08d132443267/6475979302da73a42297d6a0_Image_20230424173302.png"
                  loading="lazy" alt=""
                  sizes="(max-width: 991px) 100vw, (max-width: 1279px) 1vw, (max-width: 1439px) 100vw, (max-width: 1919px) 1vw, 66px"
                  srcset="https://uploads-ssl.webflow.com/64758c43eeea08d132443267/6475979302da73a42297d6a0_Image_20230424173302-p-500.png 500w, https://uploads-ssl.webflow.com/64758c43eeea08d132443267/6475979302da73a42297d6a0_Image_20230424173302.png 600w"
                  class="company_image" /></div>
            </div>
            <div gsap-anim-fade="" role="listitem" class="splide__slide w-dyn-item">
              <div class="company_image_wrapper"><img
                  src="https://uploads-ssl.webflow.com/64758c43eeea08d132443267/6475978563db6e5b5f14d3ce_Image_20230424173213.png"
                  loading="lazy" alt=""
                  sizes="(max-width: 991px) 100vw, (max-width: 1279px) 1vw, (max-width: 1439px) 100vw, (max-width: 1919px) 1vw, 66px"
                  srcset="https://uploads-ssl.webflow.com/64758c43eeea08d132443267/6475978563db6e5b5f14d3ce_Image_20230424173213-p-500.png 500w, https://uploads-ssl.webflow.com/64758c43eeea08d132443267/6475978563db6e5b5f14d3ce_Image_20230424173213.png 600w"
                  class="company_image" /></div>
            </div>
            <div gsap-anim-fade="" role="listitem" class="splide__slide w-dyn-item">
              <div class="company_image_wrapper"><img
                  src="https://uploads-ssl.webflow.com/64758c43eeea08d132443267/64758cd78661e084c5029841_Image_20230424173248.png"
                  loading="lazy" alt=""
                  sizes="(max-width: 991px) 100vw, (max-width: 1279px) 1vw, (max-width: 1439px) 100vw, (max-width: 1919px) 1vw, 66px"
