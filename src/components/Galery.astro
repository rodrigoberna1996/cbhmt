            </div>
            <div gsap-anim-fade="" role="listitem" class="splide__slide w-dyn-item">
              <div class="company_image_wrapper"><img
                  src="https://uploads-ssl.webflow.com/64758c43eeea08d132443267/64758c743a99deaf4e5a1129_Image_20230424173334.png"
